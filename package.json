{
  "name": "asymptote-helper",
  "publisher": "rayhuang2006",
  "displayName": "Asymptote: Competitive Programming",
  "description": "A competitive programming companion.",
  "version": "0.5.1",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rayhuang2006/asymptote.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:python",
    "onLanguage:java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "asymptote-view-container",
          "title": "Asymptote",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "asymptote-view-container": [
        {
          "type": "webview",
          "id": "asymptote-sidebar",
          "name": "Asymptote Runner",
          "icon": "media/icon.svg",
          "contextualTitle": "Asymptote"
        }
      ]
    },
    "commands": [
      {
        "command": "asymptote.refreshComplexity",
        "title": "Asymptote: Refresh Complexity"
      },
      {
        "command": "asymptote.openRunner",
        "title": "Open Asymptote Runner",
        "icon": "media/icon.svg"
      },
      {
        "command": "asymptote.toggleCodeLens",
        "title": "Asymptote: Toggle Complexity Lens"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "asymptote.openRunner",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Asymptote",
      "properties": {
        "asymptote.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Asymptote complexity analysis CodeLens."
        },
        "asymptote.chromePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to Google Chrome executable for the parser."
        },
        "asymptote.strictComparison": {
          "type": "boolean",
          "default": false,
          "description": "If enabled, test cases will require an exact character-for-character match (including trailing whitespaces and newlines)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "compile-tests": "tsc -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile-tests && npm run lint",
    "test": "mocha -r ts-node/register/transpile-only tests/**/*.test.ts",
    "pretest:vscode": "npm run compile-tests && node esbuild.js",
    "test:vscode": "vscode-test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "cheerio": "^1.2.0",
    "chrome-finder": "^1.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mocha": "^11.7.5",
    "puppeteer-core": "^24.1.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "web-tree-sitter": "^0.20.8"
  },
  "dependencies": {
    "clone-deep": "^4.0.1",
    "merge-deep": "^3.0.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  }
}
